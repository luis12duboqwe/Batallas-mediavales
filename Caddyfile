{
    email {$TLS_EMAIL}
    admin off
}

{$PUBLIC_HOST} {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    # Caddy is the only public edge. Overwrite rather than trust any
    # client-supplied forwarding chain so the internal proxy can safely use
    # this value for per-client rate limiting.
    reverse_proxy nginx:80 {
        header_up X-Forwarded-For {remote_host}
    }
}
