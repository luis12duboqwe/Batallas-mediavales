# Copy to a protected host outside the repository and replace every placeholder.
APP_ENV=staging
SECRET_KEY=replace-with-at-least-32-random-characters

# Public origin. Caddy in docker-compose.deploy.yml terminates TLS and obtains /
# renews the certificate automatically once PUBLIC_HOST resolves to this server.
PUBLIC_HOST=staging.example.com
PUBLIC_BASE_URL=https://staging.example.com
FRONTEND_URL=https://staging.example.com
CORS_ORIGINS=https://staging.example.com
TLS_EMAIL=ops@example.com
HTTP_PORT=80
HTTPS_PORT=443

# PostgreSQL inside docker-compose.deploy.yml
POSTGRES_USER=batalla
POSTGRES_PASSWORD=replace-with-a-random-database-password
POSTGRES_DB=batalla_medieval
DB_URL=postgresql+psycopg://batalla:replace-with-a-random-database-password@database:5432/batalla_medieval

# Account verification / recovery email and public beta support channel.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_STARTTLS=true
FROM_EMAIL=no-reply@example.com
SUPPORT_CONTACT=support@example.com

# Immutable release images. deploy_remote.sh replaces these placeholders with
# the exact 40-character Git commit SHA being deployed.
BACKEND_IMAGE=ghcr.io/your-owner/batalla-medieval-backend:0123456789abcdef
FRONTEND_IMAGE=ghcr.io/your-owner/batalla-medieval-frontend:0123456789abcdef

# Host-side backup policy.
BACKUP_DIR=/opt/batalla-medieval/backups
BACKUP_RETENTION_DAYS=14

# Post-deploy SLO gate. Any failure causes automatic rollback while the
# pre-deploy database snapshot is still available.
LOAD_DURATION_SECONDS=15
LOAD_CONCURRENCY=8
MAX_P95_MS=750
MAX_ERROR_RATE=0.005
