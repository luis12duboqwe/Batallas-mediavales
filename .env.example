# Local/development defaults only.
# For staging/production use ops/staging.env.example and GitHub Environment secrets.
APP_ENV=development
SECRET_KEY=replace-with-a-random-secret
FRONTEND_URL=http://localhost
PUBLIC_BASE_URL=http://localhost
CORS_ORIGINS=http://localhost

# Database
POSTGRES_USER=batalla
POSTGRES_PASSWORD=replace-with-a-random-password
POSTGRES_DB=batalla_medieval
DB_URL=postgresql+psycopg://batalla:replace-with-a-random-password@database:5432/batalla_medieval

# Email. SMTP_HOST and FROM_EMAIL are mandatory in protected environments.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_STARTTLS=true
FROM_EMAIL=
SUPPORT_CONTACT=

# Frontend/local proxy
VITE_API_URL=/api

# Protected deployment edge. Replace these only when preparing staging/production.
PUBLIC_HOST=staging.example.com
TLS_EMAIL=ops@example.com
HTTP_PORT=80
HTTPS_PORT=443

# Immutable deployment images. Never use :latest for staging/production.
BACKEND_IMAGE=ghcr.io/your-org/batalla-medieval-backend:0123456789abcdef0123456789abcdef01234567
FRONTEND_IMAGE=ghcr.io/your-org/batalla-medieval-frontend:0123456789abcdef0123456789abcdef01234567

# Backup / post-deploy budgets
BACKUP_DIR=/opt/batalla-medieval/backups
BACKUP_RETENTION_DAYS=14
LOAD_DURATION_SECONDS=15
LOAD_CONCURRENCY=8
MAX_P95_MS=750
MAX_ERROR_RATE=0.005

# Deployment metadata (real values are GitHub Environment secrets, not committed env files)
REGISTRY=ghcr.io
REMOTE_APP_DIR=/opt/batalla-medieval
