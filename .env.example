# Application settings
# Generate a long random value before deployment; never commit the real key.
APP_ENV=development
SECRET_KEY=replace-with-a-random-secret
FRONTEND_URL=http://localhost
CORS_ORIGINS=http://localhost

# Database
POSTGRES_USER=batalla
POSTGRES_PASSWORD=replace-with-a-random-password
POSTGRES_DB=batalla_medieval
DB_URL=postgresql+psycopg://batalla:replace-with-a-random-password@database:5432/batalla_medieval

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
FROM_EMAIL=

# Frontend build
VITE_API_URL=/api
HTTP_PORT=80

# Docker images (used by CI/CD & compose overrides)
BACKEND_IMAGE=ghcr.io/your-org/batalla-medieval-backend:latest
FRONTEND_IMAGE=ghcr.io/your-org/batalla-medieval-frontend:latest

# Deployment (used by GitHub Actions)
REGISTRY=ghcr.io
REGISTRY_USERNAME=github-actions
REGISTRY_PASSWORD=
SSH_HOST=your.server.com
SSH_USER=deploy
SSH_PORT=22
SSH_KEY_BASE64=
REMOTE_APP_DIR=/opt/batalla-medieval
